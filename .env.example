# =============================================================================
# MILT AI - variables de entorno (copiar a .env y ajustar). NUNCA subir .env a Git.
# Todas las variables usan el prefijo MILT_. Las listas se escriben en JSON.
# =============================================================================

# --- General -----------------------------------------------------------------
# local: un equipo, SQLite, sin dependencias externas | server: despliegue web
MILT_PROFILE=local
MILT_ENV=development
MILT_HOST=127.0.0.1
MILT_PORT=8765
# Por defecto: %APPDATA%\MILT en Windows, ~/.local/share/milt en Linux
# MILT_DATA_DIR=C:/Users/tu-usuario/AppData/Roaming/MILT
# Por defecto: SQLite en MILT_DATA_DIR/milt.db. Obligatorio en el perfil server:
# MILT_DATABASE_URL=postgresql+asyncpg://milt:CAMBIAR@localhost:5433/milt
MILT_AUTO_MIGRATE=true

# --- HTTP ----------------------------------------------------------------------
MILT_ALLOWED_HOSTS=["127.0.0.1","localhost"]
MILT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://tauri.localhost","tauri://localhost"]
MILT_LOG_LEVEL=INFO
# true: JSON (producción) | false: legible en consola (desarrollo)
MILT_LOG_JSON=false

# --- Autenticación ---------------------------------------------------------------
# Perfil local: si se omite, se genera y guarda en MILT_DATA_DIR/secrets/jwt.key
# Perfil server: obligatorio, mínimo 32 caracteres aleatorios
# MILT_JWT_SECRET=
MILT_ACCESS_TOKEN_TTL_SECONDS=900
MILT_REFRESH_TOKEN_TTL_DAYS=30
# En desarrollo sobre http://localhost los navegadores aceptan cookies Secure.
MILT_COOKIE_SECURE=true
# La primera cuenta siempre se puede crear (será administradora).
MILT_ALLOW_REGISTRATION=false
MILT_LOGIN_ATTEMPTS_PER_MINUTE=5
MILT_LOCKOUT_THRESHOLD=5

# --- Motor de IA -----------------------------------------------------------------
# ollama | fake (respuestas simuladas, para desarrollar el frontend sin Ollama)
MILT_LLM_PROVIDER=ollama
MILT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Equipo con CPU y ~10 GB de RAM: qwen3:1.7b (rápido) o qwen3:4b (mejor, más lento)
MILT_DEFAULT_MODEL=qwen3:1.7b
MILT_DEFAULT_NUM_CTX=4096
MILT_DEFAULT_TEMPERATURE=0.7
# Razonamiento "thinking" de Qwen3: muy lento en CPU, desactivado por defecto
MILT_LLM_THINK=false
MILT_LLM_READ_TIMEOUT=600
MILT_CHAT_MAX_TURNS_PER_USER=2

# --- Memoria y documentos (RAG) -------------------------------------------------
# Modelo de embeddings (instalar con: ollama pull nomic-embed-text)
MILT_EMBEDDING_MODEL=nomic-embed-text
MILT_EMBEDDING_BATCH_SIZE=16
# Qdrant en servidor (perfil server). Vacío = modo embebido en MILT_DATA_DIR/vectors
# MILT_VECTOR_URL=http://localhost:6333
MILT_MAX_UPLOAD_BYTES=26214400
MILT_CHUNK_CHARS=2000
MILT_CHUNK_OVERLAP_CHARS=250
MILT_RAG_TOP_K=4
MILT_RAG_MIN_SCORE=0.4
MILT_MEMORY_TOP_K=5
# Calibrado con nomic-embed-text (relevantes ~0,62-0,67; irrelevantes ~0,48-0,58)
MILT_MEMORY_MIN_SCORE=0.6

MILT_MAX_DOCUMENTS_PER_USER=200
MILT_MAX_CHUNKS_PER_USER=20000
MILT_MAX_DOCUMENT_CHUNKS=1000
# Parseo en subproceso con límite de tiempo (aísla archivos maliciosos)
MILT_PARSE_ISOLATED=true
MILT_PARSE_TIMEOUT_SECONDS=120
